# ---------------------------------------------------------------------------
# Supabase — required for the real backend (database + storage + auth).
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard: Project Settings > API.
#
# `.env*` is gitignored except this file. Never commit real values.
# ---------------------------------------------------------------------------

# Public project URL and browser-safe key. These are exposed to the browser by
# design (prefix NEXT_PUBLIC_).
#
# Modern projects issue a "publishable" key (sb_publishable_...).
# Older projects use the "anon" JWT. Either works; the publishable key is
# preferred when available.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Fallback / legacy name. Used only when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is
# not set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Server-only privileged key. NEVER prefix with NEXT_PUBLIC_.
# Required for order creation and for reading private book assets. Keep secret.
#
# Modern projects issue a "secret" key (sb_secret_...).
# Older projects use the "service_role" JWT. Either works.
SUPABASE_SECRET_KEY=""
# Fallback / legacy name. Used only when SUPABASE_SECRET_KEY is not set.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Optional: the storage bucket that holds book PDFs, page images and covers.
# Defaults to "book-assets" when unset. Keep it private.
# ---------------------------------------------------------------------------
SUPABASE_BOOK_BUCKET=""
